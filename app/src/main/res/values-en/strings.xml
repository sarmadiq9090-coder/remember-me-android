    <string name="set_privacy_intro">All your data stays on your phone. Remember Me has no internet permission: it sends nothing anywhere and collects no statistics.</string>
    <string name="set_privacy_permissions">Every permission and why</string>
    <string name="set_privacy_never">What we never do</string>
    <string name="set_privacy_voice">Voice input</string>
    <string name="set_privacy_voice_body">Remember Me does not record sound and has no microphone permission. When you tap the voice button, Android opens your phone\'s speech recognition service, which returns only the text. That service may send your voice to its company if it cannot work offline; we ask it to work offline when it can.</string>
    <string name="set_privacy_backups">Copies and files</string>
    <string name="set_privacy_backups_body">A copy is saved only where you choose. It is not encrypted unless you turn on Encrypt copies. The compatibility report is sent only if you share it yourself.</string>
    <string name="set_perm_notifications">Notifications</string>
    <string name="set_perm_notifications_why">To show a reminder when it is due, with Done and Snooze.</string>
    <string name="set_perm_exact">Alarms on time</string>
    <string name="set_perm_exact_why">So a reminder arrives at the minute you chose, not later.</string>
    <string name="set_perm_exact_old">Exact alarms (Android 12)</string>
    <string name="set_perm_exact_old_why">The same permission on Android 12 only, where it has another name.</string>
    <string name="set_perm_fullscreen">Full screen</string>
    <string name="set_perm_fullscreen_why">To show a reminder full screen while the phone is locked. You can turn it off in Settings.</string>
    <string name="set_perm_boot">After a restart</string>
    <string name="set_perm_boot_why">To set your reminders\' alarms again after the phone restarts.</string>
    <string name="set_perm_vibrate">Vibration</string>
    <string name="set_perm_vibrate_why">So the phone vibrates with a reminder if you want.</string>
    <string name="set_perm_battery">Battery exception request</string>
    <string name="set_perm_battery_why">So Android can ask you to allow unrestricted battery use and reminders are not delayed. Nothing happens without your yes.</string>
    <string name="set_perm_fgs">Short foreground service</string>
    <string name="set_perm_fgs_why">To play a reminder\'s tone to the end, even if you close the app.</string>
