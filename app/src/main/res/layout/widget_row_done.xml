<?xml version="1.0" encoding="utf-8"?>
<!-- A row just completed from the widget: filled check, «أُنجز: <title>», «تراجع» for 10 s (F-121). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/widget_row_bg"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="4dp">
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/widget_done_check" />
    <TextView
        android:id="@+id/w_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textDirection="locale"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/w_undo"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/widget_primary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
